@page
@model CreateNewsModel
@{
    // BẬT LAYOUT ADMIN: Hãy đảm bảo tên Layout này khớp với file layout Admin của bạn (ví dụ: "_AdminLayout" hoặc "_LayoutAdmin")
    Layout = "_AdminLayout";
    
    ViewData["Title"] = Model.IsEditing ? "Edit Game News" : "Create Game News";
}

<!-- CSS Tùy chỉnh riêng cho giao diện Dark Theme Admin -->
<style>
    /* Bố cục thẻ (Card) tối màu */
    .admin-dark-card {
        background-color: #1e1e24; /* Màu nền tối giống Admin Panel */
        border-radius: 10px;
        padding: 24px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.3);
        color: #ffffff;
        border: 1px solid #2c2c35;
    }

        .admin-dark-card h1 {
            font-size: 1.5rem;
            font-weight: 600;
            margin-bottom: 24px;
            border-bottom: 1px solid #2c2c35;
            padding-bottom: 16px;
        }

    /* Ô nhập liệu (Inputs & Textarea) */
    .admin-dark-input {
        background-color: #15151a !important; /* Màu nền input tối hơn thẻ */
        border: 1px solid #333340 !important;
        color: #ffffff !important;
        border-radius: 6px;
        padding: 10px 15px;
    }

        .admin-dark-input:focus {
            border-color: #7b61ff !important; /* Viền sáng màu tím khi focus */
            box-shadow: 0 0 0 2px rgba(123, 97, 255, 0.2) !important;
            outline: none;
        }

        .admin-dark-input::placeholder {
            color: #6b6b7b !important;
        }

    .form-label {
        font-weight: 500;
        color: #d1d1e0;
        margin-bottom: 8px;
    }

    .form-text {
        color: #8b8b9e !important;
    }

    /* Nút bấm (Buttons) */
    .btn-admin-primary {
        background-color: #7b61ff; /* Màu tím đặc trưng của Admin */
        color: white;
        border: none;
        padding: 10px 24px;
        border-radius: 6px;
        font-weight: 500;
        transition: background-color 0.2s;
    }

        .btn-admin-primary:hover {
            background-color: #6a50e5;
            color: white;
        }

    .btn-admin-secondary {
        background-color: transparent;
        color: #ff6b6b;
        border: 1px solid #ff6b6b;
        padding: 10px 24px;
        border-radius: 6px;
        font-weight: 500;
        transition: all 0.2s;
        text-decoration: none;
    }

        .btn-admin-secondary:hover {
            background-color: rgba(255, 107, 107, 0.1);
            color: #ff6b6b;
        }

    /* Thanh công cụ soạn thảo (Editor Toolbar) */
    .dark-editor-toolbar {
        background-color: #1a1a20;
        border: 1px solid #333340;
        border-bottom: none;
        border-radius: 6px 6px 0 0;
        padding: 10px;
        display: flex;
        gap: 10px;
    }

    .dark-editor-btn {
        background-color: #2c2c35;
        color: #d1d1e0;
        border: 1px solid #3e3e4a;
        padding: 6px 12px;
        border-radius: 4px;
        display: flex;
        align-items: center;
        gap: 6px;
        cursor: pointer;
        transition: all 0.2s;
    }

        .dark-editor-btn:hover {
            background-color: #3e3e4a;
            color: white;
        }

    .editor-textarea {
        border-radius: 0 0 6px 6px;
        min-height: 250px;
    }

    /* Khung xem trước (Preview) */
    .dark-preview-box {
        background-color: #15151a;
        border: 1px solid #333340;
        border-radius: 6px;
        min-height: 150px;
        padding: 16px;
        color: #d1d1e0;
    }

    /* Tùy chỉnh Modal cho khớp Dark Theme */
    .modal-content {
        background-color: #1e1e24;
        color: white;
        border: 1px solid #333340;
    }

    .modal-header {
        border-bottom: 1px solid #333340;
    }

    .modal-footer {
        border-top: 1px solid #333340;
    }
</style>

<div class="container-fluid mt-4">
    <div class="admin-dark-card">
        <h1>@(Model.IsEditing ? "Edit Game News" : "Create Game News")</h1>

        <form method="post" enctype="multipart/form-data">
            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <!-- Title Input -->
            <div class="form-group mb-4">
                <label for="Title" class="form-label">Title</label>
                <input asp-for="Input.Title" type="text" class="form-control admin-dark-input" placeholder="Enter news title..." maxlength="500" />
                <span asp-validation-for="Input.Title" class="text-danger small"></span>
            </div>

            <!-- Banner Path Input -->
            <div class="form-group mb-4">
                <label for="BannerPath" class="form-label">Banner Image (Optional)</label>
                <input asp-for="Input.BannerPath" type="text" class="form-control admin-dark-input" placeholder="e.g., Firebase image URL" />
                <span asp-validation-for="Input.BannerPath" class="text-danger small"></span>
                <small class="form-text mt-1 d-block">Paste Firebase Cloud Storage image URL</small>
            </div>

            <!-- Description Input -->
            <div class="form-group mb-4">
                <label for="Description" class="form-label">Description</label>
                <textarea asp-for="Input.Description" class="form-control admin-dark-input" placeholder="Enter news description..." maxlength="500" rows="3"></textarea>
                <span asp-validation-for="Input.Description" class="text-danger small"></span>
                <small class="form-text mt-1 text-end d-block"><span id="descriptionCount">0</span>/500</small>
            </div>

            <!-- Rich Text Editor -->
            <div class="form-group mb-4">
                <label for="Content" class="form-label">Content</label>
                <div class="dark-editor-toolbar">
                    <button type="button" class="dark-editor-btn" onclick="addSeparator()" title="Add Separator">
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
                            <line x1="0" y1="12" x2="24" y2="12" stroke="currentColor" stroke-width="2" />
                        </svg>
                        <span>Separator</span>
                    </button>
                    <button type="button" class="dark-editor-btn" onclick="showImageDialog()" title="Add Image URL">
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
                            <rect x="2" y="2" width="20" height="20" rx="2" fill="none" stroke="currentColor" stroke-width="2" />
                            <circle cx="8" cy="8" r="2" fill="currentColor" />
                            <path d="M2 16l6-6 8 8 8-8" stroke="currentColor" stroke-width="2" fill="none" />
                        </svg>
                        <span>Image</span>
                    </button>
                    <button type="button" class="dark-editor-btn" onclick="showImageBrowser()" title="Browse Cloud Images">
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
                            <path d="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z" />
                        </svg>
                        <span>Browse Images</span>
                    </button>
                    <button type="button" class="dark-editor-btn" onclick="showUploadDialog()" title="Upload Image">
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
                            <path d="M19.35 10.04C18.67 6.59 15.64 4 12 4c-1.48 0-2.85.43-4.01 1.17l1.46 1.46C10.21 5.23 11.08 5 12 5c3.04 0 5.5 2.46 5.5 5.5v.5H19c1.66 0 3 1.34 3 3 0 1.13-.64 2.11-1.56 2.62l1.45 1.45c.9-.86 1.48-2.06 1.48-3.39 0-1.5-.583-2.85-1.54-3.89zM16.5 16.5H13v3h-2v-3H8.5l4-4 4 4z" />
                        </svg>
                        <span>Upload Image</span>
                    </button>
                </div>
                <textarea asp-for="Input.Content" id="ContentEditor" class="form-control admin-dark-input editor-textarea" placeholder="Your content will appear here..."></textarea>
                <span asp-validation-for="Input.Content" class="text-danger small"></span>
                <small class="form-text mt-1 text-end d-block"><span id="contentCount">0</span>/10000</small>
            </div>

            <!-- Preview Section -->
            <div class="form-group mb-5">
                <label class="form-label">Preview</label>
                <div id="contentPreview" class="dark-preview-box"></div>
            </div>

            <!-- Submit Button -->
            <div class="d-flex justify-content-end gap-3 pt-3" style="border-top: 1px solid #2c2c35;">
                @if (Model.IsEditing && Model.EditingNewsId.HasValue)
                {
                    <a href="/News/ReadNews/@Model.EditingNewsId" class="btn-admin-secondary text-center" style="min-width: 120px;">Cancel</a>
                }
                <button type="submit" class="btn-admin-primary" style="min-width: 150px;">
                    @(Model.IsEditing ? "Update News" : "Create News")
                </button>
            </div>
        </form>
    </div>
</div>

<!-- ================================================================= -->
<!-- CÁC MODAL BÊN DƯỚI ĐƯỢC GIỮ NGUYÊN ĐỂ KHÔNG PHÁ VỠ JAVASCRIPT -->
<!-- ================================================================= -->
<!-- Image URL Dialog -->
<div id="imageDialog" class="modal-overlay" style="display: none;" onclick="closeImageDialog(event)">
    <div class="modal-content" onclick="event.stopPropagation()">
        <div class="modal-header">
            <h2>Add Image URL</h2>
            <button type="button" class="modal-close" style="color:white; background:none; border:none; font-size:1.5rem;" onclick="closeImageDialog()">&times;</button>
        </div>
        <div class="modal-body pt-3">
            <div class="form-group">
                <label for="imageName" class="form-label">Image URL</label>
                <input type="text" id="imageName" class="form-control admin-dark-input" placeholder="Paste Firebase Cloud Storage image URL" />
                <small class="form-text mt-1">Use URLs from Firebase Cloud Storage or browse below</small>
            </div>
        </div>
        <div class="modal-footer d-flex gap-2 pt-3">
            <button type="button" class="btn-admin-secondary" style="padding: 6px 16px;" onclick="closeImageDialog()">Cancel</button>
            <button type="button" class="btn-admin-primary" style="padding: 6px 16px;" onclick="insertImage()">Insert</button>
        </div>
    </div>
</div>

<!-- Image Browser Dialog -->
<div id="imageBrowserDialog" class="modal-overlay" style="display: none;" onclick="closeImageBrowser(event)">
    <div class="modal-content modal-content-large" onclick="event.stopPropagation()">
        <div class="modal-header">
            <h2>Select Cloud Image</h2>
            <button type="button" class="modal-close" style="color:white; background:none; border:none; font-size:1.5rem;" onclick="closeImageBrowser()">&times;</button>
        </div>
        <div class="modal-body pt-3">
            <div id="imageBrowserContent" class="image-browser-grid">
                <div class="loading-spinner text-center">
                    <img src="~/loading.gif" alt="Loading..." style="width:48px;height:48px;margin:0 auto 12px;display:block" />
                    <p class="text-muted">Loading images...</p>
                </div>
            </div>
        </div>
        <div class="modal-footer pt-3">
            <button type="button" class="btn-admin-secondary" style="padding: 6px 16px;" onclick="closeImageBrowser()">Close</button>
        </div>
    </div>
</div>

<!-- Image Upload Dialog -->
<div id="uploadDialog" class="modal-overlay" style="display: none;" onclick="closeUploadDialog(event)">
    <div class="modal-content" onclick="event.stopPropagation()">
        <div class="modal-header">
            <h2>Upload Image</h2>
            <button type="button" class="modal-close" style="color:white; background:none; border:none; font-size:1.5rem;" onclick="closeUploadDialog()">&times;</button>
        </div>
        <div class="modal-body pt-3">
            <div id="uploadPreview" class="upload-preview text-center mb-3" style="display: none;">
                <img id="uploadImage" alt="Preview" style="max-width: 100%; max-height: 200px; border-radius: 6px;" />
            </div>
            <div class="form-group">
                <label for="uploadFile" class="form-label">Select Image File</label>
                <input type="file" id="uploadFile" class="form-control admin-dark-input" accept="image/*" />
                <small class="form-text mt-1">Max 5MB. Supported: JPG, PNG, GIF, WebP, BMP</small>
            </div>
            <div id="uploadStatus" class="upload-status mt-2" style="display: none;"></div>
        </div>
        <div class="modal-footer d-flex gap-2 pt-3">
            <button type="button" class="btn-admin-secondary" style="padding: 6px 16px;" onclick="closeUploadDialog()">Cancel</button>
            <button type="button" class="btn-admin-primary" style="padding: 6px 16px;" id="uploadBtn" onclick="performImageUpload()">Upload & Insert</button>
        </div>
    </div>
</div>

<!-- Notification Modal -->
<div id="notificationModal" class="modal-overlay" style="display: none;" onclick="closeNotificationModal(event)">
    <div class="modal-content modal-notification" onclick="event.stopPropagation()">
        <div class="modal-header">
            <h2 id="notificationTitle">Notification</h2>
            <button type="button" class="modal-close" style="color:white; background:none; border:none; font-size:1.5rem;" onclick="closeNotificationModal()">&times;</button>
        </div>
        <div class="modal-body pt-3">
            <div id="notificationContent" class="notification-content text-center"></div>
        </div>
        <div class="modal-footer pt-3 d-flex justify-content-center">
            <button type="button" class="btn-admin-primary" style="padding: 6px 32px;" id="notificationBtn" onclick="handleNotificationAction()">OK</button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/news-editor.js"></script>
    <script>
        let notificationAction = null;

        function showNotification(title, message, type, actionCallback = null) {
            const modal = document.getElementById('notificationModal');
            const titleElem = document.getElementById('notificationTitle');
            const contentElem = document.getElementById('notificationContent');
            const btnElem = document.getElementById('notificationBtn');
            
            titleElem.textContent = title;
            contentElem.innerHTML = `<div class="notification-${type}">${escapeHtml(message)}</div>`;
            
            // Add type-specific styling
            if (type === 'success') {
                btnElem.className = 'btn-primary btn-success';
            } else if (type === 'error') {
                btnElem.className = 'btn-primary btn-danger';
            } else {
                btnElem.className = 'btn-primary';
            }
            
            notificationAction = actionCallback;
            modal.style.display = 'flex';
            btnElem.focus();
        }

        function closeNotificationModal(event) {
            if (event && event.target.id !== 'notificationModal') return;
            document.getElementById('notificationModal').style.display = 'none';
            notificationAction = null;
        }

        function handleNotificationAction() {
            closeNotificationModal();
            if (notificationAction && typeof notificationAction === 'function') {
                notificationAction();
            }
        }

        function escapeHtml(unsafe) {
            return unsafe
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#039;");
        }

        document.addEventListener('DOMContentLoaded', function() {
            const descriptionInput = document.querySelector('[asp-for="Input.Description"]');
            const contentEditor = document.getElementById('ContentEditor');
            const previewBox = document.getElementById('contentPreview');

            // Character counter for description
            if (descriptionInput) {
                descriptionInput.addEventListener('input', function() {
                    document.getElementById('descriptionCount').textContent = this.value.length;
                });
            }

            // Character counter for content
            if (contentEditor) {
                contentEditor.addEventListener('input', function() {
                    document.getElementById('contentCount').textContent = this.value.length;
                    updatePreview();
                });
            }

            // Initial character counts
            if (descriptionInput) {
                document.getElementById('descriptionCount').textContent = descriptionInput.value.length;
            }
            if (contentEditor) {
                document.getElementById('contentCount').textContent = contentEditor.value.length;
                updatePreview();
            }

            // Show notification if there's a success or error message
            const errorMessage = `@Model.ErrorMessage`;
            const successMessage = `@Model.SuccessMessage`;

            if (errorMessage && errorMessage.trim()) {
                showNotification('Error', errorMessage, 'error');
            } else if (successMessage && successMessage.trim()) {
                showNotification(
                    'Success',
                    successMessage,
                    'success',
                    function() {
                        @if (Model.IsEditing && Model.EditingNewsId.HasValue)
                        {
                            <text>
                            window.location.href = '/News/ReadNews/@Model.EditingNewsId';
                            </text>
                        }
                    }
                );
            }

            // Allow closing notification modal with Escape key
            document.addEventListener('keydown', function(event) {
                if (event.key === 'Escape') {
                    const notificationModal = document.getElementById('notificationModal');
                    if (notificationModal && notificationModal.style.display !== 'none') {
                        closeNotificationModal();
                    }
                }
            });
        });
    </script>
    <script src="~/js/news-editor.js"></script>
}