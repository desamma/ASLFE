@page
@model FE.Pages.Admin.AdminGachaModel
@{
    ViewData["Title"] = "Gacha Banner Manager";
}

<div class="container-fluid admin-wrapper mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4" style="border-bottom: 2px solid #333; padding-bottom: 15px;">
        <h2 class="admin-title m-0 border-0 p-0">Gacha Banner Manager</h2>
        <button class="btn-create-banner" type="button" onclick="openCreateBannerModal()" 
                style="background-color: #6366f1; color: white; border: none; border-radius: 6px; padding: 8px 16px; font-weight: 600; box-shadow: 0 4px 10px rgba(99, 102, 241, 0.3); cursor: pointer;">
            + Tao Banner Moi
        </button>
    </div>

    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="alert" style="background: @(Model.IsSuccess ? "rgba(16, 185, 129, 0.15)" : "rgba(239, 68, 68, 0.15)"); color: @(Model.IsSuccess ? "#10b981" : "#f87171"); border: 1px solid @(Model.IsSuccess ? "rgba(16, 185, 129, 0.3)" : "rgba(239, 68, 68, 0.3)"); border-radius: 8px; margin-bottom: 20px; font-weight: 500;">
            @(Model.IsSuccess ? "OK" : "ERROR") @Model.Message
        </div>
    }

    <div class="banner-list-container">
        @if (Model.BannerList.Count == 0)
        {
            <div style="text-align: center; padding: 60px 20px; color: #6b7280;">
                <div style="font-size: 2rem; margin-bottom: 10px;">No banners</div>
                <p style="font-size: 1.1rem; font-weight: 500;">No banners found</p>
                <p style="font-size: 0.9rem; color: #9ca3af;">Click "+ Tao Banner Moi" to create one</p>
            </div>
        }
        else
        {
            <div class="banner-grid">
                @foreach (var banner in Model.BannerList)
                {
                    <div class="banner-card @(banner.IsActive ? "active" : "inactive")">
                        <div class="banner-status-badge @(banner.IsActive ? "badge-active" : "badge-inactive")">
                            @(banner.IsActive ? "ACTIVE" : "INACTIVE")
                        </div>

                        <div class="banner-image-wrap">
                            @if (!string.IsNullOrEmpty(banner.BannerImagePath))
                            {
                                <img src="@banner.BannerImagePath" alt="@banner.Name" />
                            }
                            else
                            {
                                <div class="banner-no-image">No Image</div>
                            }
                            <div class="banner-image-overlay"></div>
                        </div>

                        <div class="banner-info">
                            <h3 class="banner-name">@banner.Name</h3>
                            <p class="banner-desc">@banner.Description</p>

                            <div class="banner-stats">
                                <div class="stat-chip">
                                    <span class="stat-label">Single</span>
                                    <span class="stat-value gem">@banner.CostPerSinglePull</span>
                                </div>
                                <div class="stat-chip">
                                    <span class="stat-label">Multi x10</span>
                                    <span class="stat-value gem">@banner.CostPerMultiPull</span>
                                </div>
                                <div class="stat-chip">
                                    <span class="stat-label">Pity</span>
                                    <span class="stat-value">@banner.PityThreshold / @banner.HardPityThreshold</span>
                                </div>
                                <div class="stat-chip">
                                    <span class="stat-label">Items</span>
                                    <span class="stat-value">@banner.AllItems.Count</span>
                                </div>
                            </div>

                            <div class="banner-dates">
                                <span>@banner.StartDate.ToString("dd/MM/yyyy") - @banner.EndDate.ToString("dd/MM/yyyy")</span>
                            </div>
                        </div>

                        <div class="banner-actions">
                            <button class="btn-action btn-items"
                                    onclick="openAddItemModal('@banner.Id', '@banner.Name')">
                                + Item
                            </button>
                            <button class="btn-action btn-edit"
                                    onclick="openEditBannerModal(
                                            '@banner.Id',
                                            @Json.Serialize(banner.Name),
                                            @Json.Serialize(banner.Description ?? ""),
                                            @Json.Serialize(banner.BannerImagePath ?? ""),
                                            @banner.CostPerSinglePull,
                                            @banner.CostPerMultiPull,
                                            @banner.PityThreshold,
                                            @banner.HardPityThreshold,
                                            '@banner.StartDate.ToString("yyyy-MM-dd")',
                                            '@banner.EndDate.ToString("yyyy-MM-dd")'
                                        )">
                                Edit
                            </button>
                            <form method="post" asp-page-handler="Toggle" class="m-0 d-inline">
                                <input type="hidden" name="bannerId" value="@banner.Id" />
                                <button type="submit" class="btn-action @(banner.IsActive ? "btn-deactivate" : "btn-activate")">
                                    @(banner.IsActive ? "Deactivate" : "Activate")
                                </button>
                            </form>
                        </div>

                        @if (banner.AllItems.Count > 0)
                        {
                            <div class="banner-items-list">
                                <div class="items-list-header">
                                    <span>Items in Banner</span>
                                    @{
                                        var totalRate = banner.AllItems.Sum(i => i.DropRate);
                                        var rateColor = Math.Abs(totalRate - 100.0) <= 0.01 ? "#10b981" : "#f59e0b";
                                    }
                                    <span style="color: @rateColor; font-size:0.72rem; font-weight:700;">
                                        Total: @totalRate.ToString("F2")%
                                        @if (Math.Abs(totalRate - 100.0) > 0.01)
                                        {
                                            <span title="Total drop rate must equal 100%">WARNING</span>
                                        }
                                    </span>
                                </div>
                                <div class="items-scroll">
                                    @foreach (var item in banner.AllItems.OrderByDescending(i => i.StarRating))
                                    {
                                        <div class="item-row star-@item.StarRating">
                                            <div class="item-star-badge">@item.StarRating Star</div>
                                            <div class="item-details">
                                                <span class="item-name">@item.ItemName</span>
                                                <span class="item-cat">@item.ItemCategory</span>
                                            </div>
                                            <div class="item-rate">@item.DropRate%</div>
                                            @if (item.IsFeatured)
                                            {
                                                <span class="item-featured-tag" title="Rate-Up">Featured</span>
                                            }
                                            <form method="post" asp-page-handler="RemoveItem" class="m-0">
                                                <input type="hidden" name="bannerId" value="@banner.Id" />
                                                <input type="hidden" name="itemId" value="@item.ItemId" />
                                                <button type="submit" class="btn-remove-item"
                                                        onclick="return confirm('Delete @item.ItemName?')">
                                                    X
                                                </button>
                                            </form>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>
</div>

<!-- MODAL: Create Banner -->
<div class="custom-modal-overlay" id="createBannerModal">
    <div class="custom-modal gacha-modal">
        <form method="post" asp-page-handler="CreateBanner" enctype="multipart/form-data" class="m-0">
            <div class="modal-header-dark">
                <div class="modal-title-wrap">
                    <span class="modal-icon">+</span>
                    <h5 class="modal-title">Create Banner</h5>
                </div>
                <button type="button" class="btn-close-custom" onclick="closeModal('createBannerModal')">X</button>
            </div>

            <div class="modal-body">
                <div class="form-row-2">
                    <div class="form-group">
                        <label class="form-label-gacha">Banner Name</label>
                        <input type="text" name="name" class="dark-input" placeholder="Eg: Stellar Wish" required />
                    </div>
                    <div class="form-group">
                        <label class="form-label-gacha">Description</label>
                        <input type="text" name="description" class="dark-input" placeholder="Short description..." />
                    </div>
                </div>

                <!-- Image: File or URL -->
                <div class="image-input-group">
                    <div class="image-tab-bar">
                        <button type="button" class="img-tab active" onclick="switchImgTab('create', 'file', this)">
                            Upload File
                        </button>
                        <button type="button" class="img-tab" onclick="switchImgTab('create', 'url', this)">
                            Use URL
                        </button>
                    </div>
                    <div id="create-img-file" class="img-tab-panel">
                        <label class="form-label-gacha">Select Image</label>
                        <div class="file-drop-zone" id="createDropZone"
                             ondragover="event.preventDefault(); this.classList.add('dragover')"
                             ondragleave="this.classList.remove('dragover')"
                             ondrop="handleFileDrop(event, 'bannerImage', 'createDropZone', 'createImgPreview')">
                            <input type="file" name="bannerImage" id="bannerImage" accept="image/*"
                                   onchange="previewImage(this, 'createImgPreview', 'createDropZone')" />
                            <div class="drop-zone-inner" id="createDropZone-label">
                                <span class="drop-icon">Image</span>
                                <span class="drop-text">Drag and drop or click to select</span>
                                <span class="drop-hint">PNG, JPG, WebP - Max 5MB</span>
                            </div>
                            <img id="createImgPreview" src="" alt="" style="display:none;width:100%;height:120px;object-fit:cover;border-radius:8px;" />
                        </div>
                    </div>
                    <div id="create-img-url" class="img-tab-panel" style="display:none;">
                        <label class="form-label-gacha">Image URL</label>
                        <input type="text" name="bannerImagePath" class="dark-input"
                               placeholder="https://... or /images/banners/..." />
                        <p class="input-hint">Example: https://cdn.example.com/banner.jpg</p>
                    </div>
                </div>

                <div class="form-row-4">
                    <div class="form-group">
                        <label class="form-label-gacha gem-label">Single Cost</label>
                        <input type="number" name="costPerSinglePull" class="dark-input" value="100" min="1" required />
                    </div>
                    <div class="form-group">
                        <label class="form-label-gacha gem-label">Multi Cost</label>
                        <input type="number" name="costPerMultiPull" class="dark-input" value="1000" min="1" required />
                    </div>
                    <div class="form-group">
                        <label class="form-label-gacha pity-label">Soft Pity</label>
                        <input type="number" name="pityThreshold" class="dark-input" value="75" min="1" required />
                    </div>
                    <div class="form-group">
                        <label class="form-label-gacha pity-label">Hard Pity</label>
                        <input type="number" name="hardPityThreshold" class="dark-input" value="90" min="1" required />
                    </div>
                </div>

                <div class="form-row-2">
                    <div class="form-group">
                        <label class="form-label-gacha">Start Date</label>
                        <input type="date" name="startDate" class="dark-input" required />
                    </div>
                    <div class="form-group">
                        <label class="form-label-gacha">End Date</label>
                        <input type="date" name="endDate" class="dark-input" required />
                    </div>
                </div>
            </div>

            <div class="modal-footer-dark">
                <button type="button" class="btn-cancel-modal" onclick="closeModal('createBannerModal')">Cancel</button>
                <button type="submit" class="btn-save-modal">Create Banner</button>
            </div>
        </form>
    </div>
</div>

<!-- MODAL: Edit Banner -->
<div class="custom-modal-overlay" id="editBannerModal">
    <div class="custom-modal gacha-modal">
        <form method="post" asp-page-handler="UpdateBanner" enctype="multipart/form-data" class="m-0">
            <input type="hidden" name="bannerId" id="editBannerId" />
            <div class="modal-header-dark">
                <div class="modal-title-wrap">
                    <span class="modal-icon" style="color:#60a5fa;">Edit</span>
                    <h5 class="modal-title">Edit Banner</h5>
                </div>
                <button type="button" class="btn-close-custom" onclick="closeModal('editBannerModal')">X</button>
            </div>

            <div class="modal-body">
                <div class="form-row-2">
                    <div class="form-group">
                        <label class="form-label-gacha">Banner Name</label>
                        <input type="text" name="name" id="editName" class="dark-input" required />
                    </div>
                    <div class="form-group">
                        <label class="form-label-gacha">Description</label>
                        <input type="text" name="description" id="editDescription" class="dark-input" />
                    </div>
                </div>

                <!-- Image: File or URL -->
                <div class="image-input-group">
                    <div class="image-tab-bar">
                        <button type="button" class="img-tab active" onclick="switchImgTab('edit', 'url', this)">
                            Keep/Change URL
                        </button>
                        <button type="button" class="img-tab" onclick="switchImgTab('edit', 'file', this)">
                            Upload New File
                        </button>
                    </div>
                    <div id="edit-img-url" class="img-tab-panel">
                        <label class="form-label-gacha">Image URL</label>
                        <input type="text" name="bannerImagePath" id="editImagePath" class="dark-input"
                               placeholder="Leave empty to keep current" />
                        <div id="editCurrentImgPreview" style="margin-top:8px;display:none;">
                            <p class="input-hint" style="margin-bottom:4px;">Current image:</p>
                            <img id="editCurrentImg" src="" style="height:80px;border-radius:6px;object-fit:cover;" />
                        </div>
                    </div>
                    <div id="edit-img-file" class="img-tab-panel" style="display:none;">
                        <label class="form-label-gacha">Upload New Image</label>
                        <div class="file-drop-zone" id="editDropZone"
                             ondragover="event.preventDefault(); this.classList.add('dragover')"
                             ondragleave="this.classList.remove('dragover')"
                             ondrop="handleFileDrop(event, 'bannerImageFile', 'editDropZone', 'editImgPreview')">
                            <input type="file" name="bannerImageFile" id="editBannerImageFile" accept="image/*"
                                   onchange="previewImage(this, 'editImgPreview', 'editDropZone')" />
                            <div class="drop-zone-inner" id="editDropZone-label">
                                <span class="drop-icon">Image</span>
                                <span class="drop-text">Drag and drop or click to select</span>
                                <span class="drop-hint">Will replace old image</span>
                            </div>
                            <img id="editImgPreview" src="" alt="" style="display:none;width:100%;height:120px;object-fit:cover;border-radius:8px;" />
                        </div>
                    </div>
                </div>

                <div class="form-row-4">
                    <div class="form-group">
                        <label class="form-label-gacha gem-label">Single Cost</label>
                        <input type="number" name="costPerSinglePull" id="editSingleCost" class="dark-input" min="1" required />
                    </div>
                    <div class="form-group">
                        <label class="form-label-gacha gem-label">Multi Cost</label>
                        <input type="number" name="costPerMultiPull" id="editMultiCost" class="dark-input" min="1" required />
                    </div>
                    <div class="form-group">
                        <label class="form-label-gacha pity-label">Soft Pity</label>
                        <input type="number" name="pityThreshold" id="editPity" class="dark-input" min="1" required />
                    </div>
                    <div class="form-group">
                        <label class="form-label-gacha pity-label">Hard Pity</label>
                        <input type="number" name="hardPityThreshold" id="editHardPity" class="dark-input" min="1" required />
                    </div>
                </div>

                <div class="form-row-2">
                    <div class="form-group">
                        <label class="form-label-gacha">Start Date</label>
                        <input type="date" name="startDate" id="editStartDate" class="dark-input" required />
                    </div>
                    <div class="form-group">
                        <label class="form-label-gacha">End Date</label>
                        <input type="date" name="endDate" id="editEndDate" class="dark-input" required />
                    </div>
                </div>
            </div>

            <div class="modal-footer-dark">
                <button type="button" class="btn-cancel-modal" onclick="closeModal('editBannerModal')">Cancel</button>
                <button type="submit" class="btn-save-modal" style="background:linear-gradient(135deg,#3b82f6,#6366f1);">
                    Save Changes
                </button>
            </div>
        </form>
    </div>
</div>

<!-- MODAL: Add Item to Banner -->
<div class="custom-modal-overlay" id="addItemModal">
    <div class="custom-modal gacha-modal" style="max-width:700px;">
        <form method="post" asp-page-handler="AddItem" class="m-0">
            <input type="hidden" name="bannerId" id="addItemBannerId" />
            <input type="hidden" name="itemId" id="selectedItemId" />
            <input type="hidden" name="itemCategory" id="selectedItemCategory" />

            <div class="modal-header-dark">
                <div class="modal-title-wrap">
                    <span class="modal-icon" style="color:#f59e0b;">*</span>
                    <h5 class="modal-title">
                        Add Item - <span id="addItemBannerName" style="color:#f59e0b;"></span>
                    </h5>
                </div>
                <button type="button" class="btn-close-custom" onclick="closeModal('addItemModal')">X</button>
            </div>

            <div class="modal-body">
                <div class="form-row-2" style="gap:10px;">
                    <div class="form-group" style="position:relative;">
                        <label class="form-label-gacha">Search Item</label>
                        <input type="text" id="itemSearchInput" class="dark-input"
                               placeholder="Enter item name..." oninput="filterItems()" />
                    </div>
                    <div class="form-group">
                        <label class="form-label-gacha">Filter by Type</label>
                        <select id="itemTypeFilter" class="dark-input dark-select" onchange="filterItems()">
                            <option value="">All</option>
                        </select>
                    </div>
                </div>

                <div style="border:1px solid #27272a; border-radius:10px; overflow:hidden;">
                    <div style="padding:8px 14px; background:#0d0d10; font-size:0.68rem; font-weight:700;
                                letter-spacing:1px; color:#3f3f46; text-transform:uppercase;
                                display:flex; justify-content:space-between; align-items:center;">
                        <span>Select Item From Database</span>
                        <span id="itemCountLabel" style="color:#52525b;"></span>
                    </div>
                    <div id="itemPickerList" style="max-height:280px; overflow-y:auto; padding:8px;
                                                    scrollbar-width:thin; scrollbar-color:#27272a transparent;">
                        <div style="text-align:center; padding:30px; color:#52525b; font-size:0.85rem;">
                            <span id="itemListStatus">Loading items...</span>
                        </div>
                    </div>
                </div>

                <div id="selectedItemPreview" style="display:none; background:#0d0d10;
                     border:1px solid rgba(245,158,11,0.3); border-radius:10px; padding:14px 16px;">
                    <div style="font-size:0.68rem; font-weight:700; letter-spacing:1px;
                                color:#f59e0b; text-transform:uppercase; margin-bottom:10px;">
                        Selected
                    </div>
                    <div class="item-row" style="background:#1a1a22; border-color:#27272a;">
                        <img id="previewSelectedImg" src="" style="width:36px;height:36px;border-radius:6px;
                                                                    object-fit:cover;display:none;" />
                        <div class="item-star-badge" id="previewSelectedStar" style="background:rgba(245,158,11,0.2);color:#f59e0b;">-</div>
                        <div class="item-details">
                            <span class="item-name" id="previewSelectedName">-</span>
                            <span class="item-cat" id="previewSelectedCat">-</span>
                        </div>
                    </div>
                </div>

                <div class="form-row-2">
                    <div class="form-group">
                        <label class="form-label-gacha">Drop Rate (%)</label>
                        <input type="number" name="dropRate" id="addDropRate" class="dark-input"
                               placeholder="0.6" step="0.01" min="0.01" max="100" required />
                        <p class="input-hint" id="remainingRateHint"></p>
                    </div>
                    <div class="form-group">
                        <label class="form-label-gacha star-label">Star Rating (override)</label>
                        <select name="starRating" id="addStarRating" class="dark-input dark-select" required>
                            <option value="3">3 Star</option>
                            <option value="4">4 Star</option>
                            <option value="5" selected>5 Star</option>
                        </select>
                    </div>
                </div>

                <div class="form-group featured-toggle-wrap">
                    <label class="featured-toggle-label">
                        <input type="checkbox" name="isFeatured" class="featured-checkbox" value="true" />
                        <span class="toggle-track"><span class="toggle-thumb"></span></span>
                        <span class="featured-text">Featured Item (Rate-Up)</span>
                    </label>
                    <p class="input-hint">Enable if this item has special rate-up in banner</p>
                </div>
            </div>

            <div class="modal-footer-dark">
                <button type="button" class="btn-cancel-modal" onclick="closeModal('addItemModal')">Cancel</button>
                <button type="submit" id="btnAddItemSubmit" class="btn-save-modal"
                        style="background:linear-gradient(135deg,#f59e0b,#ef4444); opacity:0.4; pointer-events:none;">
                    Add Item
                </button>
            </div>
        </form>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/Pages/Admin/AdminGacha.cshtml.css" asp-append-version="true" />
}

@section Scripts {
    <script>
        function openCreateBannerModal() {
            document.getElementById('createBannerModal').classList.add('show');
        }

        function closeModal(id) {
            document.getElementById(id).classList.remove('show');
            if (id === 'createBannerModal') {
                resetFileInput('bannerImage', 'createImgPreview', 'createDropZone');
            }
            if (id === 'editBannerModal') {
                resetFileInput('editBannerImageFile', 'editImgPreview', 'editDropZone');
            }
        }

        document.querySelectorAll('.custom-modal-overlay').forEach(overlay => {
            overlay.addEventListener('click', e => {
                if (e.target === overlay) {
                    closeModal(overlay.id);
                }
            });
        });

        document.addEventListener('keydown', e => {
            if (e.key === 'Escape') {
                document.querySelectorAll('.custom-modal-overlay.show').forEach(m => {
                    closeModal(m.id);
                });
            }
        });

        function switchImgTab(prefix, tab, btn) {
            btn.closest('.image-tab-bar').querySelectorAll('.img-tab').forEach(t => t.classList.remove('active'));
            btn.classList.add('active');

            const filePanel = document.getElementById(`${prefix}-img-file`);
            const urlPanel  = document.getElementById(`${prefix}-img-url`);
            if (tab === 'file') {
                filePanel.style.display = 'block';
                urlPanel.style.display  = 'none';
            } else {
                filePanel.style.display = 'none';
                urlPanel.style.display  = 'block';
            }
        }

        function previewImage(input, previewId, dropZoneId) {
            const preview  = document.getElementById(previewId);
            const dropZone = document.getElementById(dropZoneId);
            const label    = document.getElementById(dropZoneId + '-label');

            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = e => {
                    preview.src = e.target.result;
                    preview.style.display = 'block';
                    if (label) label.style.display = 'none';
                    if (dropZone) dropZone.classList.add('has-preview');
                };
                reader.readAsDataURL(input.files[0]);
            }
        }

        function handleFileDrop(event, inputName, dropZoneId, previewId) {
            event.preventDefault();
            const dropZone = document.getElementById(dropZoneId);
            dropZone.classList.remove('dragover');

            const file = event.dataTransfer.files[0];
            if (!file || !file.type.startsWith('image/')) return;

            const input = dropZone.querySelector(`input[name="${inputName}"]`);
            if (input) {
                const dt = new DataTransfer();
                dt.items.add(file);
                input.files = dt.files;
                previewImage(input, previewId, dropZoneId);
            }
        }

        function resetFileInput(inputId, previewId, dropZoneId) {
            const input   = document.getElementById(inputId);
            const preview = document.getElementById(previewId);
            const label   = document.getElementById(dropZoneId + '-label');
            const dropZone= document.getElementById(dropZoneId);
            if (input)   input.value = '';
            if (preview) { preview.src = ''; preview.style.display = 'none'; }
            if (label)   label.style.display = 'flex';
            if (dropZone)dropZone.classList.remove('has-preview');
        }

        function openEditBannerModal(id, name, desc, img, single, multi, pity, hardPity, start, end) {
            document.getElementById('editBannerId').value    = id;
            document.getElementById('editName').value        = name;
            document.getElementById('editDescription').value = desc;
            document.getElementById('editImagePath').value   = img;
            document.getElementById('editSingleCost').value  = single;
            document.getElementById('editMultiCost').value   = multi;
            document.getElementById('editPity').value        = pity;
            document.getElementById('editHardPity').value    = hardPity;
            document.getElementById('editStartDate').value   = start;
            document.getElementById('editEndDate').value     = end;

            const currentImgWrap = document.getElementById('editCurrentImgPreview');
            const currentImg     = document.getElementById('editCurrentImg');
            if (img && img.trim() !== '') {
                currentImg.src = img;
                currentImgWrap.style.display = 'block';
            } else {
                currentImgWrap.style.display = 'none';
            }

            const urlTab = document.querySelector('#editBannerModal .img-tab');
            if (urlTab) switchImgTab('edit', 'url', urlTab);
            resetFileInput('editBannerImageFile', 'editImgPreview', 'editDropZone');

            document.getElementById('editBannerModal').classList.add('show');
        }

        let allItems     = [];
        let filteredItems= [];
        let currentBannerItems = [];

        async function openAddItemModal(bannerId, bannerName) {
            document.getElementById('addItemBannerId').value  = bannerId;
            document.getElementById('addItemBannerName').textContent = bannerName;

            clearSelectedItem();
            document.getElementById('itemSearchInput').value  = '';
            document.getElementById('itemTypeFilter').value   = '';
            document.getElementById('addDropRate').value      = '';
            document.getElementById('remainingRateHint').textContent = '';

            document.getElementById('addItemModal').classList.add('show');

            currentBannerItems = Array.from(
                document.querySelectorAll(`form[asp-page-handler*="RemoveItem"] input[name="itemId"]`)
            ).filter(el => {
                const bannerInput = el.closest('form').querySelector('input[name="bannerId"]');
                return bannerInput && bannerInput.value === bannerId;
            }).map(el => el.value);

            if (allItems.length === 0) {
                await loadAllItems();
            } else {
                renderItems(filteredItems.length > 0 ? filteredItems : allItems);
            }
        }

        async function loadAllItems() {
            document.getElementById('itemPickerList').innerHTML =
                '<div style="text-align:center;padding:30px;color:#52525b;font-size:0.85rem;">Loading items...</div>';

            try {
                const res  = await fetch('?handler=AllItems', { credentials: 'same-origin' });
                if (!res.ok) throw new Error(`HTTP ${res.status}`);

                const json = await res.json();
                allItems = json.data ?? json.Data ?? json ?? [];

                if (!Array.isArray(allItems)) allItems = [];

                const types  = [...new Set(allItems.map(i => i.type || i.Type || '').filter(Boolean))].sort();
                const select = document.getElementById('itemTypeFilter');
                select.innerHTML = '<option value="">All</option>';
                types.forEach(t => {
                    const opt = document.createElement('option');
                    opt.value = t; opt.textContent = t;
                    select.appendChild(opt);
                });

                filteredItems = [...allItems];
                renderItems(filteredItems);
            } catch (e) {
                document.getElementById('itemPickerList').innerHTML =
                    `<div style="text-align:center;padding:30px;color:#ef4444;font-size:0.85rem;">
                        Error loading items<br>
                        <span style="color:#52525b;font-size:0.75rem;">${e.message}</span>
                     </div>`;
            }
        }

        function filterItems() {
            const search = document.getElementById('itemSearchInput').value.toLowerCase().trim();
            const type   = document.getElementById('itemTypeFilter').value.toLowerCase();

            filteredItems = allItems.filter(item => {
                const name = (item.name || item.Name || '').toLowerCase();
                const cat  = (item.type || item.Type || '').toLowerCase();
                return (!search || name.includes(search)) && (!type || cat === type);
            });
            renderItems(filteredItems);
        }

        function renderItems(items) {
            const list = document.getElementById('itemPickerList');
            document.getElementById('itemCountLabel').textContent = `${items.length} items`;

            if (items.length === 0) {
                list.innerHTML = '<div style="text-align:center;padding:20px;color:#52525b;font-size:0.85rem;">No items found</div>';
                return;
            }

            const selectedId = document.getElementById('selectedItemId').value;

            list.innerHTML = items.map(item => {
                const id       = item.id || item.Id || item.itemId || item.ItemId;
                const name     = item.name || item.Name || 'Unknown';
                const type     = item.type || item.Type || '';
                const imgPath  = item.imagePath || item.ImagePath || '';
                const isSelected  = String(id) === String(selectedId);
                const alreadyIn   = currentBannerItems.includes(String(id));

                const borderColor = isSelected ? 'rgba(245,158,11,0.4)' : alreadyIn ? 'rgba(16,185,129,0.25)' : '#27272a';
                const bgColor     = isSelected ? 'rgba(245,158,11,0.08)' : alreadyIn ? 'rgba(16,185,129,0.05)' : '#1a1a22';
                const cursor      = alreadyIn && !isSelected ? 'not-allowed' : 'pointer';
                const opacity     = alreadyIn && !isSelected ? '0.55' : '1';

                return `<div onclick="${alreadyIn && !isSelected ? '' : `selectItem('${id}','${name.replace(/'/g,"\\'")}','${type}','${imgPath.replace(/'/g,"\\'")}', this)`}"
                             style="display:flex;align-items:center;gap:10px;padding:9px 10px;border-radius:8px;
                                    margin-bottom:4px;cursor:${cursor};opacity:${opacity};
                                    border:1px solid ${borderColor};background:${bgColor};transition:all 0.15s;">
                    ${imgPath
                        ? `<img src="${imgPath}" style="width:36px;height:36px;border-radius:6px;object-fit:cover;flex-shrink:0;"
                                 onerror="this.style.display='none'" />`
                        : `<div style="width:36px;height:36px;border-radius:6px;background:#27272a;display:flex;
                                       align-items:center;justify-content:center;color:#52525b;font-size:1rem;flex-shrink:0;">Item</div>`}
                    <div style="flex:1;min-width:0;">
                        <div style="font-size:0.87rem;font-weight:600;color:#e4e4e7;
                                     overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${name}</div>
                        <div style="font-size:0.72rem;color:#52525b;">${type || 'No type'}</div>
                    </div>
                    ${isSelected
                        ? '<span style="color:#f59e0b;font-size:1rem;flex-shrink:0;">Check</span>'
                        : alreadyIn
                            ? '<span style="color:#10b981;font-size:0.7rem;flex-shrink:0;white-space:nowrap;">Added</span>'
                            : ''}
                </div>`;
            }).join('');
        }

        function selectItem(id, name, type, imgPath, el) {
            document.getElementById('selectedItemId').value      = id;
            document.getElementById('selectedItemCategory').value= type;

            document.getElementById('previewSelectedName').textContent = name;
            document.getElementById('previewSelectedCat').textContent  = type || '-';
            document.getElementById('previewSelectedStar').textContent = '-';

            const img = document.getElementById('previewSelectedImg');
            if (imgPath) { img.src = imgPath; img.style.display = 'block'; }
            else { img.style.display = 'none'; }

            document.getElementById('selectedItemPreview').style.display = 'block';

            const btn = document.getElementById('btnAddItemSubmit');
            btn.style.opacity      = '1';
            btn.style.pointerEvents= 'auto';

            renderItems(filteredItems);
        }

        function clearSelectedItem() {
            document.getElementById('selectedItemId').value      = '';
            document.getElementById('selectedItemCategory').value= '';
            document.getElementById('selectedItemPreview').style.display = 'none';
            const btn = document.getElementById('btnAddItemSubmit');
            btn.style.opacity      = '0.4';
            btn.style.pointerEvents= 'none';
        }
    </script>
}
